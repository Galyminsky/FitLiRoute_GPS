<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="60dp" android:height="60dp" android:gravity="center">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="30dp" android:startColor="#66FF693B" android:endColor="#00FF693B" />
        </shape>
    </item>
    <item android:width="20dp" android:height="20dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FF693B" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
