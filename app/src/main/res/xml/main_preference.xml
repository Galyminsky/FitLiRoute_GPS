<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Preference android:title="@string/setting_menu" android:selectable="false" app:layout="@layout/preference_screen_title" />
    <PreferenceCategory android:title="@string/design_geolocation" app:layout="@layout/preference_section_heading">
        <Preference android:title="@string/design_location" android:summary="@string/design_location_summary" android:selectable="false" app:icon="@drawable/icon17_location" app:layout="@layout/preference_design_row" />
        <ListPreference android:defaultValue="3000" android:entries="@array/loc_time_update_name" android:entryValues="@array/loc_time_update_value" android:key="update_time_key" android:title="@string/design_update_interval" app:icon="@drawable/icon17_hours" app:layout="@layout/preference_design_row" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/design_display" app:layout="@layout/preference_section_heading">
        <ListPreference android:defaultValue="#FA2C2C" android:entries="@array/color_name" android:entryValues="@array/color_value" android:key="color_key" android:title="@string/truck_color" app:icon="@drawable/icon17_palette" app:layout="@layout/preference_design_row" />
    </PreferenceCategory>
</PreferenceScreen>
